{
	"$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
	"grammars": [
		{
			"name": "cooklang",
			"camelcase": "Cooklang",
			"title": "Cooklang",
			"scope": "source.cooklang",
			"file-types": ["cooklang", "cook", "menu"],
			"injection-regex": "^cooklang$",
			"class-name": "TreeSitterCooklang",
			"highlights": "queries/highlights.scm",
			"injections": "queries/injections.scm",
			"folds": "queries/folds.scm"
		}
	],
	"metadata": {
		"version": "0.1.0",
		"license": "MIT",
		"description": "Cooklang grammar for tree-sitter",
		"authors": [
			{
				"name": "Tom Spencer",
				"url": "https://github.com/swonky"
			}
		],
		"links": {
			"repository": "https://github.com/swonky/tree-sitter-cooklang",
			"funding": ""
		}
	}
}
